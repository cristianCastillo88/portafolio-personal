---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Cristian Castillo — Software Engineer especializado en .NET, Clean Architecture y aplicaciones web de alto rendimiento." />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<ViewTransitions />
		<title>{title}</title>
	</head>
	<body
		class="bg-[#0B0F17] text-slate-100 min-h-screen selection:bg-blue-600/30 selection:text-white"
	>
		<slot />
	</body>
</html>
