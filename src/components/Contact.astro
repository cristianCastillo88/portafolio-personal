---

---

<section id="contact" class="mb-20 reveal">
    <div
        class="bg-gradient-to-b from-[#111827] to-[#0D131F] border border-slate-800 rounded-2xl overflow-hidden shadow-2xl relative"
    >
        <!-- Acento de borde superior -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-600 via-sky-400 to-transparent"></div>

        <div class="grid md:grid-cols-2">
            <!-- Columna izquierda: Datos de contacto -->
            <div class="p-8 md:p-12 order-2 md:order-1 space-y-8">
                <div>
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-blue-950/60 border border-blue-800/50 text-blue-400 text-xs font-mono font-medium uppercase tracking-wider mb-3">
                        <span>[ CANAL DIRECTO ]</span>
                    </span>
                    <h2 class="text-3xl font-bold text-white font-display">
                        Contacto & Consultas
                    </h2>
                    <p class="text-slate-400 text-sm md:text-base mt-2 leading-relaxed">
                        ¿Tienes un proyecto, propuesta o desafío técnico? Conversemos sobre los requerimientos, arquitectura o posibilidades de colaboración.
                    </p>
                </div>

                <div class="space-y-5">
                    <div class="flex items-center gap-4 p-3 rounded-xl bg-slate-900/60 border border-slate-800">
                        <div
                            class="size-10 bg-blue-600/10 border border-blue-500/30 rounded-lg flex items-center justify-center text-blue-400 shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="size-5"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs font-mono text-slate-400 uppercase tracking-wider">
                                Correo Electrónico
                            </p>
                            <a href="mailto:cristcastillo08@gmail.com" class="text-white text-sm font-medium hover:text-blue-300 transition-colors">
                                cristcastillo08@gmail.com
                            </a>
                        </div>
                    </div>

                    <div class="flex items-center gap-4 p-3 rounded-xl bg-slate-900/60 border border-slate-800">
                        <div
                            class="size-10 bg-blue-600/10 border border-blue-500/30 rounded-lg flex items-center justify-center text-blue-400 shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="size-5"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs font-mono text-slate-400 uppercase tracking-wider">
                                WhatsApp / Móvil
                            </p>
                            <a href="https://wa.me/5493512556008" target="_blank" rel="noopener noreferrer" class="text-white text-sm font-medium hover:text-blue-300 transition-colors">
                                +54 9 3512556008
                            </a>
                        </div>
                    </div>

                    <div class="flex items-center gap-4 p-3 rounded-xl bg-slate-900/60 border border-slate-800">
                        <div
                            class="size-10 bg-blue-600/10 border border-blue-500/30 rounded-lg flex items-center justify-center text-blue-400 shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="size-5"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs font-mono text-slate-400 uppercase tracking-wider">
                                Modalidad & Ubicación
                            </p>
                            <p class="text-white text-sm font-medium">
                                Remoto — Disponible globalmente
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna derecha: Formulario -->
            <div
                class="bg-slate-950/60 p-8 md:p-12 order-1 md:order-2 flex items-center border-b md:border-b-0 md:border-l border-slate-800"
            >
                <div class="relative w-full">
                    <form
                        id="contact-form"
                        action="https://formsubmit.co/cristcastillo08@gmail.com"
                        method="POST"
                        class="w-full space-y-4 transition-opacity duration-300"
                    >
                        <input type="hidden" name="_captcha" value="false" />
                        <input
                            type="hidden"
                            name="_subject"
                            value="Nuevo contacto desde Portafolio — Cristian Castillo"
                        />
                        <input type="hidden" name="_template" value="table" />

                        <div>
                            <label
                                for="name"
                                class="block text-xs font-mono text-slate-300 uppercase tracking-wider mb-1.5"
                                >Nombre Completo</label
                            >
                            <input
                                type="text"
                                id="name"
                                name="name"
                                required
                                class="w-full rounded-lg border border-slate-800 bg-slate-900/90 text-white placeholder-slate-500 px-3.5 py-2.5 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors"
                                placeholder="Tu nombre o empresa"
                            />
                        </div>
                        <div>
                            <label
                                for="email"
                                class="block text-xs font-mono text-slate-300 uppercase tracking-wider mb-1.5"
                                >Correo Electrónico</label
                            >
                            <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                class="w-full rounded-lg border border-slate-800 bg-slate-900/90 text-white placeholder-slate-500 px-3.5 py-2.5 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors"
                                placeholder="tu@email.com"
                            />
                        </div>
                        <div>
                            <label
                                for="message"
                                class="block text-xs font-mono text-slate-300 uppercase tracking-wider mb-1.5"
                                >Mensaje o Detalle del Proyecto</label
                            >
                            <textarea
                                id="message"
                                name="message"
                                rows="4"
                                required
                                class="w-full rounded-lg border border-slate-800 bg-slate-900/90 text-white placeholder-slate-500 px-3.5 py-2.5 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors resize-none"
                                placeholder="Describe el contexto, stack o requerimiento..."
                            ></textarea>
                        </div>
                        <button
                            type="submit"
                            id="submit-btn"
                            class="w-full bg-blue-600 hover:bg-blue-500 text-white font-mono text-xs font-medium py-3 px-6 rounded-lg transition-colors cursor-pointer flex items-center justify-center gap-2 shadow-lg shadow-blue-600/20 active:scale-98 disabled:opacity-50 disabled:cursor-not-allowed"
                        >
                            <span>Enviar Mensaje</span>
                            <svg
                                id="spinner"
                                class="animate-spin size-4 text-white hidden"
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                            >
                                <circle
                                    class="opacity-25"
                                    cx="12"
                                    cy="12"
                                    r="10"
                                    stroke="currentColor"
                                    stroke-width="4"></circle>
                                <path
                                    class="opacity-75"
                                    fill="currentColor"
                                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                                ></path>
                            </svg>
                        </button>
                    </form>

                    <!-- Success Message -->
                    <div
                        id="success-message"
                        class="absolute inset-0 hidden flex-col items-center justify-center text-center bg-slate-900/95 backdrop-blur-sm z-10 rounded-lg p-6"
                    >
                        <div
                            class="size-14 bg-emerald-950 border border-emerald-800 text-emerald-400 rounded-full flex items-center justify-center mb-4"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="size-7"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                        <h3
                            class="text-lg font-bold text-white mb-1.5 font-display"
                        >
                            ¡Mensaje Transmitido con Éxito!
                        </h3>
                        <p class="text-slate-400 text-xs mb-6 max-w-xs">
                            Gracias por comunicarte. He recibido tu mensaje y te responderé a la brevedad.
                        </p>
                        <button
                            id="new-message-btn"
                            class="text-blue-400 font-mono text-xs hover:underline cursor-pointer"
                        >
                            ← Enviar otro mensaje
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const submitBtn = document.getElementById(
        "submit-btn",
    ) as HTMLButtonElement;
    const spinner = document.getElementById("spinner");
    const btnText = submitBtn?.querySelector("span");
    const successMessage = document.getElementById("success-message");
    const newMessageBtn = document.getElementById("new-message-btn");

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (submitBtn && spinner && btnText) {
            submitBtn.disabled = true;
            spinner.classList.remove("hidden");
            btnText.textContent = "Transmitiendo...";
        }

        try {
            const formData = new FormData(form);
            const response = await fetch(form.action, {
                method: "POST",
                body: formData,
                headers: {
                    Accept: "application/json",
                },
            });

            if (response.ok) {
                form.classList.add("opacity-0", "pointer-events-none");
                successMessage?.classList.remove("hidden");
                successMessage?.classList.add("flex");
                form.reset();
            } else {
                alert(
                    "Hubo un error al enviar el mensaje. Por favor intenta nuevamente.",
                );
            }
        } catch (error) {
            console.error("Error:", error);
            alert("Hubo un error al enviar el mensaje. Verifica tu conexión.");
        } finally {
            if (submitBtn && spinner && btnText) {
                submitBtn.disabled = false;
                spinner.classList.add("hidden");
                btnText.textContent = "Enviar Mensaje";
            }
        }
    });

    newMessageBtn?.addEventListener("click", () => {
        successMessage?.classList.add("hidden");
        successMessage?.classList.remove("flex");
        form?.classList.remove("opacity-0", "pointer-events-none");
    });
</script>
