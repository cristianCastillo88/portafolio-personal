---
interface Props {
    techs?: string[];
}

const {
    techs = [
        "C# / .NET 8",
        "Clean Architecture",
        "Astro 5 (SSR)",
        "MySQL",
        "React 18",
        "Tailwind CSS",
        "TypeScript",
        "SignalR",
        "Entity Framework Core",
    ],
} = Astro.props;

const duplicatedTechs = [...techs, ...techs];
---

<div class="w-full overflow-hidden mask-fade relative py-2">
    <div class="flex gap-3 animate-marquee w-max hover:pause">
        {
            duplicatedTechs.map((tech) => (
                <div class="px-3.5 py-1.5 bg-slate-900 border border-slate-800 text-slate-300 rounded-md font-mono text-xs whitespace-nowrap hover:border-blue-500/50 hover:text-white transition-colors shadow-sm">
                    {tech}
                </div>
            ))
        }
    </div>
</div>

<style>
    .animate-marquee {
        animation: marquee 28s linear infinite;
    }

    .mask-fade {
        mask-image: linear-gradient(
            to right,
            transparent,
            black 10%,
            black 90%,
            transparent
        );
        -webkit-mask-image: linear-gradient(
            to right,
            transparent,
            black 10%,
            black 90%,
            transparent
        );
    }

    .hover\:pause:hover {
        animation-play-state: paused;
    }

    @keyframes marquee {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }
</style>
