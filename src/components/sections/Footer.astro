---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-800/80 py-10 bg-[#080C14]">
    <div
        class="max-w-[1200px] mx-auto px-6 md:px-10 flex flex-col md:flex-row justify-between items-center gap-6"
    >
        <div class="flex items-center gap-3">
            <div class="size-7 rounded-lg bg-blue-600/10 border border-blue-500/30 flex items-center justify-center text-blue-400">
                <span class="font-mono font-bold text-xs">CC</span>
            </div>
            <span class="text-white font-bold text-sm tracking-tight font-display">Cristian Castillo</span>
            <span class="text-xs font-mono text-slate-500">// Software Engineer</span>
        </div>
        <div class="text-slate-500 text-xs font-mono text-center md:text-right">
            © {currentYear} Cristian Castillo. Arquitectura robusta & Web moderna.
        </div>
    </div>
</footer>
