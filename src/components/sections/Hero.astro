---
import { siteData } from "../../data/siteData";

const { hero } = siteData;
---

<section id="home" class="mb-20 pt-4">
    <div class="relative rounded-2xl border border-slate-800/90 bg-gradient-to-b from-[#0F1626] via-[#0D131F] to-[#0A0E17] p-8 md:p-14 overflow-hidden shadow-2xl">
        <!-- Luz de fondo técnica sobria -->
        <div class="absolute -top-32 right-0 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-72 h-72 bg-sky-600/5 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-3xl space-y-6">
            <!-- Badge de especialidad / disponibilidad -->
            <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-slate-700/80 text-xs font-mono text-slate-300">
                <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>{hero.roleBadge}</span>
                <span class="text-slate-600">|</span>
                <span class="text-blue-400 font-semibold">.NET & Modern Web</span>
            </div>

            <!-- Título principal -->
            <div class="space-y-2">
                <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white font-display">
                    {hero.title}
                </h1>
                <p class="text-lg md:text-xl font-medium text-blue-300/90 font-display">
                    {hero.subtitle}
                </p>
            </div>

            <!-- Descripción -->
            <p class="text-slate-300 text-sm md:text-base leading-relaxed max-w-2xl">
                {hero.description}
            </p>

            <!-- Acciones CTA -->
            <div class="flex flex-wrap items-center gap-4 pt-2">
                <a
                    href="#portfolio"
                    class="h-11 px-6 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm font-mono flex items-center gap-2 transition-all shadow-lg shadow-blue-600/20 active:scale-98"
                >
                    <span>{hero.ctaPrimary}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                    </svg>
                </a>
                <a
                    href="#contact"
                    class="h-11 px-6 rounded-lg bg-slate-900/90 hover:bg-slate-800 text-slate-200 hover:text-white border border-slate-800 font-medium text-sm font-mono flex items-center transition-all"
                >
                    {hero.ctaSecondary}
                </a>
                <a
                    href="https://github.com/cristianCastillo88"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="h-11 px-4 rounded-lg bg-slate-900/40 hover:bg-slate-800/80 text-slate-400 hover:text-white border border-slate-800/60 font-mono text-xs flex items-center gap-2 transition-all"
                >
                    <svg class="size-4 fill-current" viewBox="0 0 24 24">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    <span>GitHub Profile</span>
                </a>
            </div>
        </div>
    </div>
</section>

