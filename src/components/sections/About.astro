---
import { siteData } from "../../data/siteData";
import TechMarquee from "../TechMarquee.astro";

const { about } = siteData;
---

<section id="about" class="mb-24 reveal">
    <div
        class="tilt-card bg-gradient-to-b from-[#111827] to-[#0D131F] border border-slate-800 rounded-2xl overflow-hidden shadow-2xl relative"
    >
        <!-- Acento de línea superior -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-600 via-sky-500 to-transparent"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
            <div class="p-8 md:p-12 lg:col-span-7 space-y-6">
                <div>
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-blue-950/60 border border-blue-800/50 text-blue-400 text-xs font-mono font-medium uppercase tracking-wider mb-3">
                        <span>[ PERFIL DE INGENIERÍA ]</span>
                    </span>
                    <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white font-display">
                        {about.name}
                    </h2>
                    <p class="text-sm md:text-base text-blue-300 font-medium mt-1">
                        {about.tagline}
                    </p>
                </div>

                <p class="text-slate-300 text-sm md:text-base leading-relaxed">
                    {about.description}
                </p>

                <!-- Stack Principal -->
                <div class="space-y-3">
                    <p class="text-xs font-mono uppercase tracking-wider text-slate-400">
                        Tecnologías & Herramientas Centrales:
                    </p>
                    <div class="-mx-8 md:mx-0">
                        <TechMarquee techs={about.technologies} />
                    </div>
                </div>

                <!-- Enlaces y CV -->
                <div class="pt-2">
                    <p class="text-xs font-mono uppercase tracking-wider text-slate-400 mb-3">
                        Conexión Profesional:
                    </p>
                    <div class="flex flex-wrap gap-3">
                        {
                            about.socials.map((social) => (
                                <a
                                    href={social.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-blue-500/50 hover:bg-slate-800/80 transition-all font-mono text-xs"
                                    aria-label={social.ariaLabel}
                                >
                                    {social.platform === "LinkedIn" && (
                                        <svg class="size-4 fill-current text-blue-400" viewBox="0 0 24 24">
                                            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.66 1.66 0 0 0-1.66 1.66c0 .92.74 1.66 1.66 1.66a1.66 1.66 0 0 0 1.66-1.66c0-.92-.74-1.66-1.66-1.66Z"/>
                                        </svg>
                                    )}
                                    {social.platform === "GitHub" && (
                                        <svg class="size-4 fill-current text-slate-200" viewBox="0 0 24 24">
                                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                        </svg>
                                    )}
                                    {social.platform === "Instagram" && (
                                        <svg class="size-4 fill-none stroke-current text-sky-400" stroke-width="2" viewBox="0 0 24 24">
                                            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                                            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
                                        </svg>
                                    )}
                                    <span>{social.platform}</span>
                                </a>
                            ))
                        }
                        <a
                            href="/cv.pdf"
                            download="Cristian_Castillo_CV.pdf"
                            class="flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-mono text-xs font-medium transition-all shadow-sm shadow-blue-600/20"
                            title="Descargar Curriculum Vitae"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                            </svg>
                            <span>Descargar CV</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Ilustración de Workspace -->
            <div class="p-8 lg:p-12 lg:col-span-5 flex items-center justify-center">
                <div class="relative w-full max-w-sm rounded-xl overflow-hidden border border-slate-800 shadow-2xl group bg-slate-950">
                    <img
                        alt="Workspace de Software Engineer"
                        class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700 opacity-90"
                        src="/profile-3d.png"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-[#0B0F17] via-transparent to-transparent opacity-80 pointer-events-none"></div>
                    <div class="absolute bottom-3 left-4 right-4 font-mono text-[11px] text-slate-400 flex items-center justify-between">
                        <span>WORKSPACE // IDE</span>
                        <span class="text-blue-400">.NET 8 & ASTRO</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
