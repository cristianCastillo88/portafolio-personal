---
import { siteData } from "../../data/siteData";

const { navbarLinks } = siteData;
---

<header
    id="navbar"
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 w-full bg-[#0B0F17]/90 backdrop-blur-md border-b border-slate-800/80"
>
    <div
        class="max-w-[1200px] mx-auto px-6 md:px-10 py-3.5 flex items-center justify-between whitespace-nowrap"
    >
        <!-- Logo de Ingeniero -->
        <a href="#home" class="flex items-center gap-3 group">
            <div class="size-8 rounded-lg bg-blue-600/10 border border-blue-500/30 flex items-center justify-center text-blue-400 group-hover:border-blue-400/60 transition-colors">
                <span class="font-mono font-bold text-sm">CC</span>
            </div>
            <div class="flex flex-col">
                <span class="text-white text-sm font-bold tracking-tight font-display leading-tight group-hover:text-blue-300 transition-colors">
                    Cristian Castillo
                </span>
                <span class="text-[10px] font-mono text-slate-400 tracking-wider">
                    SOFTWARE ENGINEER
                </span>
            </div>
        </a>

        <!-- Enlaces centrales -->
        <nav class="hidden md:flex items-center gap-1 bg-slate-900/80 border border-slate-800/80 rounded-full px-3 py-1">
            {
                navbarLinks.map((link) => (
                    <a
                        class="nav-link px-3.5 py-1.5 rounded-full text-xs font-mono text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all duration-200"
                        href={link.href}
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>

        <!-- CTA de Contacto -->
        <div class="flex items-center gap-3">
            <a
                href="#contact"
                class="inline-flex items-center justify-center rounded-lg h-9 px-4 bg-blue-600 hover:bg-blue-500 text-white text-xs font-mono font-medium transition-all shadow-sm shadow-blue-600/20 active:scale-95"
            >
                Contacto
            </a>
        </div>
    </div>
</header>

<script>
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
    const sections = document.querySelectorAll("section[id], div[id]");

    const scrollSpyObserver = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    const id = entry.target.getAttribute("id");
                    navLinks.forEach((link) => {
                        const href = link.getAttribute("href");
                        if (href === `#${id}`) {
                            link.classList.add("bg-blue-600/20", "text-blue-300", "font-semibold");
                            link.classList.remove("text-slate-300");
                        } else {
                            link.classList.remove("bg-blue-600/20", "text-blue-300", "font-semibold");
                            link.classList.add("text-slate-300");
                        }
                    });
                }
            });
        },
        { rootMargin: "-30% 0px -60% 0px" }
    );

    sections.forEach((section) => {
        if (section.id) scrollSpyObserver.observe(section);
    });
</script>
